{
    "name": "ixbox/moonlight",
    "description": "Bake Set-Cookie headers for PSR-7 responses.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cookie",
        "set-cookie",
        "psr-7",
        "http"
    ],
    "authors": [
        {
            "name": "KUBO Seiya"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-message": "^1.0|^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8.2",
        "pestphp/pest": "^3.8|^4.0|^5.0",
        "phpstan/phpstan": "^2.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Ixbox\\Moonlight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ixbox\\Moonlight\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
