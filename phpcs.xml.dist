<?xml version="1.0"?>
<ruleset name="moonlight">
    <arg name="colors"/>
    <arg value="sp"/>
    <file>src</file>
    <file>tests</file>
    <rule ref="PSR12"/>
    <!-- Pest test files declare tests with function calls, not classes. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
